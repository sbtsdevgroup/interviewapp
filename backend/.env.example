# Copy to backend/.env for local development (no Docker).
# macOS uses port 5000 for AirPlay Receiver, so the API runs on 5001 locally.
PORT=5001
JWT_SECRET=local-dev-secret

# Needed for written-answer grading and voice transcription. Leave empty to skip AI grading.
OPENAI_API_KEY=

# ICBM main backend that holds student records. Point it at a local or staging instance.
SOURCE_API_URL=http://localhost:3002/api
INTERNAL_API_KEY=student-portal-internal-key-2024

# Admin account seeded on first start
ADMIN_EMAIL=admin@dbi.edu.ng
ADMIN_PASSWORD=admin123

# Optional: path used by the maintenance scripts (rescore, add-bonus-marks)
# AI_DB_PATH=./data/ai_interviews.db
